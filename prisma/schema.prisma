// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"

}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
 
//ENUM

enum UserType {
  SUPER_ADMIN
  ADMIN
  USER
}

enum StatutDemande {
  ACCEPTEE
  REFUSEE
  EN_ATTENTE
}

enum TypeNotification{
  REUNION
  RETARD
  ACTION
}



enum TRSType{
  INITIAL
  FINAL
}

enum ParameterCategory {
  DISPONIBILITE
  PERFORMANCE
  QUALITE
}

enum Statut{
  EN_COURS
  TERMINE
  EN_RETARD
}

enum AnalyseType {
  BRAINSTORMING
  PARETO
  CINQ_POURQUOI
  ISHIKAWA
}


//User
model User{
  id Int @id @default(autoincrement())
  name String
  userRole String?
  email String @unique
  password String
  status Boolean @default(true)
  type UserType

  mustChangePassword Boolean @default(true)

  adminId Int? 

  userPermissions UserPermission[]
  roles UserRole[]
  notifications Notification[]
  emails Email[]
  actions Action[]
}


//ROLE
model Role {
  id Int @id @default(autoincrement())
  name String 

  users UserRole[]
  permissions RolePermission []
}

model Permission {
  id   Int    @id @default(autoincrement())
  name String 

  roles RolePermission[]
  userPermissions UserPermission[] 
}

model UserRole {
  userId Int
  roleId Int

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model RolePermission {
  roleId Int
  permissionId Int

  role Role @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model UserPermission {
  userId       Int
  permissionId Int
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

//DEMANDE
model Demande{
  id          Int           @id @default(autoincrement())
  nom         String
  rue         String
  codePostal  String
  ville       String
  telephone   String
  email       String
  statut      StatutDemande @default(EN_ATTENTE)
  date        DateTime      @default(now())
}

//NOTIFICATION
model Notification{
  id Int @id @default(autoincrement())
  message String
  date DateTime @default(now())
  type TypeNotification
  lu Boolean @default(false)

  userId Int
  user User @relation(fields: [userId], references: [id])
}

//EMAIL
model Email {
  id Int @id @default(autoincrement())
  contenu String
  dateEnvoi DateTime @default(now())

  userId Int
  user User @relation(fields: [userId], references: [id])
}

//RESSOURCE
model Ressource{
  id          Int    @id @default(autoincrement())
  nom         String
  type        String
  description String
  adminId     Int
  statut      Boolean @default(true)  

  parameters  ResourceParameter[] 
  trs         TRS[]
  workflows   Workflow[]
  objectifs   Objectif[] 

}

//TRS
model TRS{
  id Int @id @default(autoincrement())
  type TRSType
  valeur Float

  ressourceId Int
  ressource Ressource @relation(fields: [ressourceId], references: [id], onDelete: Cascade)

  disponibilite Disponibilite?
  performance Performance?
  qualite Qualite?
}

// les champs de disponibilité
model ResourceParameter {
  id          Int               @id @default(autoincrement())
  label       String
  // This link allows one parameter to have many daily values
  dailyValues DailyValue[]

  category    ParameterCategory // Use the Enum here
  ressourceId Int
  ressource   Ressource         @relation(fields: [ressourceId], references: [id], onDelete: Cascade)
}

model DailyValue {
  id          Int      @id @default(autoincrement())
  date        DateTime @default(now())
  value       Float    // The actual number entered for that day
  
  parameterId Int
  parameter   ResourceParameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)
}


model Disponibilite {
  id Int @id @default(autoincrement())
  valeur Float


  trsId Int @unique
  trs TRS @relation(fields: [trsId], references: [id], onDelete: Cascade)
}

model Performance {
  id Int @id @default(autoincrement())
  valeur Float


  trsId Int @unique
  trs TRS @relation(fields: [trsId], references: [id], onDelete: Cascade)
}

model Qualite {
  id Int @id @default(autoincrement())
  valeur Float



  trsId Int @unique
  trs TRS @relation(fields: [trsId], references: [id])
}

//PROCESSUS D'AMELIORATION
model Workflow {
  id Int @id @default(autoincrement())
  dateDebut DateTime
  dateFin DateTime?
  statut Statut

  ressourceId Int
  ressource Ressource @relation(fields: [ressourceId], references: [id])

  analyses Analyse[]
  planAction PlanAction?
}

//ANALYSE
model Analyse{
  id Int @id @default(autoincrement())
  type AnalyseType
  contenu String

  workflowId Int
  workflow Workflow @relation(fields: [workflowId], references: [id]) 
}

//PLAN ACTION
model PlanAction {
  id Int @id @default(autoincrement())
  description String
  statut Statut
  dateDebut DateTime
  dateFin DateTime?

  workflowId  Int      @unique
  workflow    Workflow @relation(fields: [workflowId], references: [id])

  actions     Action[]
  promptIA    PromptIA?
  tracking    Tracking[]
}

//ACTION
model Action {
  id Int @id @default(autoincrement())
  description String
  statut Statut

  planId Int
  plan   PlanAction @relation(fields: [planId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])
}

//IA
model PromptIA {
  id Int @id @default(autoincrement())
  contenu String
  reponse String

  planId Int @unique
  plan PlanAction @relation(fields: [planId], references: [id])
}

//TRACKING
model Tracking {
  id Int @id @default(autoincrement())
  progression Int
  commentaire String
  dateDebut   DateTime
  dateFin     DateTime?

  planId Int
  plan PlanAction @relation(fields: [planId], references: [id])
}

//OBJECTIF TRS
model Objectif {
  id          Int      @id @default(autoincrement())
  title       String?
  description String?
  valeurCible Float                          
  dateDebut   DateTime @default(now())
  dateFin     DateTime?                      

  ressourceId Int
  ressource   Ressource @relation(fields: [ressourceId], references: [id])
}
