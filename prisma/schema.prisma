// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"

}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
 
//ENUM

enum UserType {
  SUPER_ADMIN
  ADMIN
  USER
}

enum StatutDemande {
  ACCEPTEE
  REFUSEE
  EN_ATTENTE
}

enum TypeNotification{
  REUNION
  RETARD
  ACTION
}



enum TRSType{
  INITIAL
  FINAL
}

enum ParameterCategory {
  DISPONIBILITE
  PERFORMANCE
  QUALITE
}

enum Statut{
  EN_COURS
  TERMINE
  EN_RETARD
}

enum AnalyseType {
  BRAINSTORMING
  PARETO
  CINQ_POURQUOI
  ISHIKAWA
}


//User
model User{
  id Int @id @default(autoincrement())
  name String
  userRole String?
  email String @unique
  password String
  status Boolean @default(true)
  type UserType

  mustChangePassword Boolean @default(true)

  adminId Int? 

  userPermissions UserPermission[]
  roles UserRole[]
  notifications Notification[]
  emails Email[]
  actions Action[]
}


//ROLE
model Role {
  id Int @id @default(autoincrement())
  name String 

  users UserRole[]
  permissions RolePermission []
}

model Permission {
  id   Int    @id @default(autoincrement())
  name String 

  roles RolePermission[]
  userPermissions UserPermission[] 
}

model UserRole {
  userId Int
  roleId Int

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model RolePermission {
  roleId Int
  permissionId Int

  role Role @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model UserPermission {
  userId       Int
  permissionId Int
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

//DEMANDE
model Demande{
  id          Int           @id @default(autoincrement())
  nom         String
  rue         String
  codePostal  String
  ville       String
  telephone   String
  email       String
  statut      StatutDemande @default(EN_ATTENTE)
  date        DateTime      @default(now())
}

//NOTIFICATION
model Notification{
  id Int @id @default(autoincrement())
  message String
  date DateTime @default(now())
  type TypeNotification
  lu Boolean @default(false)

  userId Int
  user User @relation(fields: [userId], references: [id])
}

//EMAIL
model Email {
  id Int @id @default(autoincrement())
  contenu String
  dateEnvoi DateTime @default(now())

  userId Int
  user User @relation(fields: [userId], references: [id])
}

// RESSOURCE
// RESSOURCE
model Ressource {
  id          Int      @id @default(autoincrement())
  nom          String
  type         String
  description String
  adminId      Int      
  statut       Boolean  @default(true)

  // Link to the initial values provided at creation
  initialDisponibilite Float?
  initialPerformance   Float?
  initialQualite       Float?
  initialTRS           Float?

  parameters  ResourceParameter[]
  trs         TRS[]
  objectifs   Objectif[]
  
  // New: Relation to store the history of calculated percentages
  metrics     CalculatedMetric[]
}


//  Stores the result of your calculation after every "Collecte de données"
model CalculatedMetric {
  id           Int               @id @default(autoincrement())
  date         DateTime          @default(now())
  
  category     ParameterCategory // DISPONIBILITE, PERFORMANCE, or QUALITE
  valeur       Float             // The resulting percentage (%)

  ressourceId  Int
  ressource    Ressource         @relation(fields: [ressourceId], references: [id], onDelete: Cascade)
}

//TRS
model TRS{
  id Int @id @default(autoincrement())
  type TRSType
  valeur Float

  ressourceId Int
  ressource Ressource @relation(fields: [ressourceId], references: [id], onDelete: Cascade)

  disponibilite Disponibilite?
  performance Performance?
  qualite Qualite?
}

// store the fields names
model ResourceParameter {
  id           Int               @id @default(autoincrement())
  label        String            // e.g., "Temps d'arrêt" or "Total Produit"
  category     ParameterCategory 
  
  dailyValues  DailyValue[]
  
  ressourceId  Int
  ressource    Ressource         @relation(fields: [ressourceId], references: [id], onDelete: Cascade)
}

model DailyValue {
  id          Int      @id @default(autoincrement())
  date        DateTime @default(now())
  value       Float    // The actual number entered for that day
  
  parameterId Int
  parameter   ResourceParameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)
}


model Disponibilite {
  id Int @id @default(autoincrement())
  valeur Float

  trsId Int @unique
  trs TRS @relation(fields: [trsId], references: [id], onDelete: Cascade) // Add this
}

model Performance {
  id Int @id @default(autoincrement())
  valeur Float

  trsId Int @unique
  trs TRS @relation(fields: [trsId], references: [id], onDelete: Cascade) // Add this
}

model Qualite {
  id Int @id @default(autoincrement())
  valeur Float

  trsId Int @unique
  trs TRS @relation(fields: [trsId], references: [id], onDelete: Cascade) // Add this
}

// PROCESSUS D'AMELIORATION (The "Traitement")
model Workflow {
  id              Int       @id @default(autoincrement()) // This is an Int
  nom             String
  description     String?
  valeurTrsGlobal Float     
  statut          String    @default("EN_COURS")
  dateDebut       DateTime  @default(now())
  dateFin         DateTime?
  
  // RELATIONS
  analyses        Analyse[] 
  planAction      PlanAction? 
}

model Analyse {
  id         Int      @id @default(autoincrement())
  workflowId Int      // CHANGED: String -> Int to match Workflow.id
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  type       String   
  contenu    String   @db.Text 
  createdAt  DateTime @default(now())
}

// PLAN ACTION
model PlanAction {
  id          Int       @id @default(autoincrement())
  description String
  statut      Statut    @default(EN_COURS)
  dateDebut   DateTime  @default(now())
  dateFin     DateTime?

  workflowId  Int       @unique // CHANGED: String -> Int to match Workflow.id
  workflow    Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  actions     Action[]
  promptIA    PromptIA?
  tracking    Tracking[]
}

//ACTION
model Action {
  id Int @id @default(autoincrement())
  description String
  statut Statut

  planId Int
  plan   PlanAction @relation(fields: [planId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])
}

//IA
model PromptIA {
  id Int @id @default(autoincrement())
  contenu String
  reponse String

  planId Int @unique
  plan PlanAction @relation(fields: [planId], references: [id])
}

//TRACKING
model Tracking {
  id Int @id @default(autoincrement())
  progression Int
  commentaire String
  dateDebut   DateTime
  dateFin     DateTime?

  planId Int
  plan PlanAction @relation(fields: [planId], references: [id])
}

//OBJECTIF TRS
model Objectif {
  id          Int      @id @default(autoincrement())
  title       String?
  description String?
  valeurCible Float                          
  dateDebut   DateTime @default(now())
  dateFin     DateTime?                      

  ressourceId Int
  ressource   Ressource @relation(fields: [ressourceId], references: [id] , onDelete: Cascade)
}
